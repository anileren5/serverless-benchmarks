{
  "experiments": {
    "update_code": false,
    "update_storage": false,
    "download_results": true,
    "deployment": "openwhisk",
    "architecture": "x64",
    "container_deployment": true,
    "runtime": {
      "language": "nodejs",
      "version": "20"
    },
    "perf-cost": {
      "benchmark": "313.serverless-ci",
