{
  "benchmark": "505.cpu-oversubscription",
  "configurations": [
    {
      "name": "e1-resources",
      "description": "Reported versus effective CPUs across the memory range.",
      "input-size": "test",
      "input": {"threads": [1], "order": "shuffled"},
      "memory-sizes": [128, 256, 512, 768, 1024, 1536, 1769, 2048, 2560, 3008],
      "omp-wait-policies": [null],
      "repetitions": 32,
      "concurrent-invocations": 8
    },
    {
      "name": "e2-thread-sweep-small",
      "description": "Oversubscription penalty across thread counts.",
      "input-size": "small",
      "input": {"threads": [1, 2, 3, 4, 6, 8, 16, 32, 64], "order": "shuffled"},
      "memory-sizes": [128, 512, 1769, 3008],
      "omp-wait-policies": [null],
      "repetitions": 32,
      "concurrent-invocations": 8
    },
    {
      "name": "e2-thread-sweep-large",
      "description": "Same sweep with a larger grid, only where it finishes in reasonable time.",
      "input-size": "large",
      "input": {"threads": [1, 2, 3, 4, 6, 8, 16, 32, 64], "order": "shuffled"},
      "memory-sizes": [1769, 3008],
      "omp-wait-policies": [null],
      "repetitions": 32,
      "concurrent-invocations": 8
    },
    {
      "name": "e3-wait-policy",
      "description": "Spin-waiting workers under fractional CPUs; cold starts fix the policy.",
      "input-size": "small",
      "input": {"threads": [2, 32], "order": "shuffled"},
      "memory-sizes": [128, 1769, 3008],
      "omp-wait-policies": [null, "active", "passive"],
      "cold-starts": true,
      "repetitions": 16,
      "concurrent-invocations": 8
    },
    {
      "name": "e4-timeout-baseline",
      "description": "Work sized to take about 60% of the 300 s timeout on one thread at 128 MB.",
      "input-size": "large",
      "input": {"iterations": 2000, "threads": [1]},
      "memory-sizes": [128],
      "omp-wait-policies": [null],
      "cold-starts": true,
      "repetitions": 4,
      "concurrent-invocations": 4
    },
    {
      "name": "e4-timeout-oversubscribed",
      "description": "The same work on two threads, the CPU count the sandbox reports.",
      "input-size": "large",
      "input": {"iterations": 2000, "threads": [2]},
      "memory-sizes": [128],
      "omp-wait-policies": [null, "active"],
      "cold-starts": true,
      "repetitions": 4,
      "concurrent-invocations": 4
    }
  ]
}
