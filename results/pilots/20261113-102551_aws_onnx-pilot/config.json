{
  "experiment": {
    "benchmark": "412.image-recognition-onnx",
    "configurations": [
      {
        "name": "onnx-thread-sweep",
        "description": "ResNet-50 inference in ONNX Runtime across intra-op thread counts, with and without spinning workers.",
        "input-size": "small",
        "input": {
          "threads": [
            1,
            2,
            3,
            4,
            8
          ],
          "order": "shuffled"
        },
        "memory-sizes": [
          512,
          1024,
          1769,
          3008
        ],
        "omp-wait-policies": [
          null,
          "passive"
        ],
        "repetitions": 2,
        "concurrent-invocations": 2
      }
    ],
    "label": "onnx-pilot"
  },
  "deployment": {
    "name": "aws",
    "region": "eu-north-1"
  },
  "runtime": {
    "language": "python",
    "version": "3.11"
  },
  "architecture": "x64"
}