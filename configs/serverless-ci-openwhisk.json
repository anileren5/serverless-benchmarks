      "shutdownStorage": false,
      "removeCluster": false,
      "wskBypassSecurity": "true",
      "wskExec": "wsk",
      "experimentalManifest": false,
      "removeStaleContainers": true,
      "kubectlExec": "kubectl",
      "kubernetesNamespace": "openwhisk",
      "dockerhubRepository": null,
      "docker_registry": {
        "registry": "",
        "username": "",
        "password": ""
      }
    }
  }
}
